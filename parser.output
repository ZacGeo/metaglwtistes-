Grammar

    0 $accept: program $end

    1 program: global_declarations main_function

    2 global_declarations: global_declarations global_declaration
    3                    | /* empty */

    4 global_declaration: typedef_declaration
    5                   | const_declaration
    6                   | enum_declaration
    7                   | class_declaration
    8                   | union_declaration
    9                   | global_var_declaration
   10                   | func_declaration
   11                   | error SEMI

   12 typedef_declaration: TYPEDEF typename listspec ID dims SEMI

   13 typename: standard_type
   14         | ID

   15 standard_type: CHAR
   16              | INT
   17              | FLOAT
   18              | STRING
   19              | VOID

   20 listspec: LIST
   21         | /* empty */

   22 dims: dims dim
   23     | /* empty */

   24 dim: LBRACK ICONST RBRACK
   25    | LBRACK RBRACK

   26 $@1: /* empty */

   27 const_declaration: CONST typename $@1 constdefs SEMI

   28 constdefs: constdefs COMMA constdef
   29          | constdef

   30 constdef: ID dims ASSIGN init_value

   31 init_value: expression
   32           | LBRACE init_values RBRACE

   33 init_values: init_values COMMA init_value
   34            | init_value

   35 expression: or_expression

   36 or_expression: or_expression OROP and_expression
   37              | and_expression

   38 and_expression: and_expression ANDOP equality_expression
   39               | equality_expression

   40 equality_expression: equality_expression EQUOP relational_expression
   41                    | relational_expression

   42 relational_expression: relational_expression RELOP additive_expression
   43                      | additive_expression

   44 additive_expression: additive_expression ADDOP multiplicative_expression
   45                    | multiplicative_expression

   46 multiplicative_expression: multiplicative_expression MULOP unary_expression
   47                          | unary_expression

   48 unary_expression: NOTOP unary_expression
   49                 | ADDOP unary_expression
   50                 | SIZEOP unary_expression
   51                 | INCDEC variable
   52                 | postfix_expression

   53 postfix_expression: variable INCDEC
   54                   | variable
   55                   | variable LPAREN expression_list RPAREN
   56                   | LENGTH LPAREN general_expression RPAREN
   57                   | constant
   58                   | LPAREN general_expression RPAREN
   59                   | LPAREN standard_type RPAREN
   60                   | listexpression

   61 variable: variable LBRACK general_expression RBRACK
   62         | variable DOT ID
   63         | LISTFUNC LPAREN general_expression RPAREN
   64         | decltype ID
   65         | THIS

   66 general_expression: general_expression COMMA assignment
   67                   | assignment

   68 assignment: variable ASSIGN assignment
   69           | expression

   70 expression_list: general_expression
   71                | /* empty */

   72 constant: CCONST
   73         | ICONST
   74         | FCONST
   75         | SCONST

   76 listexpression: LBRACK expression_list RBRACK

   77 $@2: /* empty */

   78 enum_declaration: ENUM ID $@2 enum_body SEMI

   79 enum_body: LBRACE id_list RBRACE
   80          | LBRACE error RBRACE

   81 id_list: id_list COMMA ID initializer
   82        | ID initializer

   83 initializer: ASSIGN init_value
   84            | /* empty */

   85 $@3: /* empty */

   86 class_declaration: CLASS ID $@3 class_body SEMI

   87 class_body: parent LBRACE members_methods RBRACE
   88           | parent LBRACE error RBRACE

   89 parent: COLON ID
   90       | /* empty */

   91 members_methods: members_methods access member_or_method
   92                | access member_or_method

   93 access: PRIVATE COLON
   94       | PROTECTED COLON
   95       | PUBLIC COLON
   96       | /* empty */

   97 member_or_method: member
   98                 | method

   99 member: var_declaration
  100       | anonymous_union

  101 var_declaration: typename variabledefs SEMI

  102 variabledefs: variabledefs COMMA variabledef
  103             | variabledef

  104 variabledef: listspec ID dims

  105 anonymous_union: UNION union_body SEMI

  106 union_body: LBRACE fields RBRACE
  107           | LBRACE error RBRACE

  108 fields: fields field
  109       | field

  110 field: var_declaration

  111 method: short_func_declaration

  112 short_func_declaration: short_par_func_header SEMI
  113                       | nopar_func_header SEMI

  114 short_par_func_header: func_header_start LPAREN parameter_types RPAREN

  115 func_header_start: typename listspec ID

  116 parameter_types: parameter_types COMMA prototype_parameter
  117                | prototype_parameter

  118 prototype_parameter: typename REFER
  119                    | typename listspec dims

  120 nopar_func_header: func_header_start LPAREN RPAREN

  121 $@4: /* empty */

  122 union_declaration: UNION ID $@4 union_body SEMI

  123 global_var_declaration: typename init_variabledefs SEMI

  124 init_variabledefs: init_variabledefs COMMA init_variabledef
  125                  | init_variabledef

  126 init_variabledef: variabledef initializer

  127 func_declaration: short_func_declaration
  128                 | full_func_declaration

  129 full_func_declaration: full_par_func_header function_body

  130 $@5: /* empty */

  131 full_func_declaration: nopar_class_func_header $@5 function_body

  132 $@6: /* empty */

  133 full_func_declaration: nopar_func_header $@6 function_body

  134 full_par_func_header: class_func_header_start LPAREN parameter_list RPAREN
  135                     | func_header_start LPAREN parameter_list RPAREN

  136 class_func_header_start: typename listspec func_class ID

  137 func_class: ID METH

  138 parameter_list: parameter_list COMMA named_parameter
  139               | named_parameter

  140 named_parameter: typename REFER ID
  141                | typename listspec ID dims

  142 nopar_class_func_header: class_func_header_start LPAREN RPAREN

  143 function_body: LBRACE decl_statements RBRACE
  144              | LBRACE error RBRACE

  145 decl_statements: declarations statements
  146                | declarations
  147                | statements
  148                | /* empty */

  149 declarations: declarations local_declaration
  150             | local_declaration

  151 local_declaration: decltype typename variabledefs SEMI
  152                  | decltype typename error SEMI
  153                  | decltype typename variabledefs error

  154 decltype: STATIC
  155         | /* empty */

  156 statements: statements statement
  157           | statement

  158 statement: expression_statement
  159          | if_statement
  160          | while_statement
  161          | for_statement
  162          | return_statement
  163          | io_statement
  164          | comp_statement
  165          | CONTINUE SEMI
  166          | BREAK SEMI
  167          | SEMI
  168          | error SEMI

  169 expression_statement: general_expression SEMI

  170 if_statement: IF LPAREN general_expression RPAREN statement
  171             | IF LPAREN general_expression RPAREN statement ELSE statement

  172 $@7: /* empty */

  173 while_statement: WHILE LPAREN general_expression RPAREN $@7 statement

  174 $@8: /* empty */

  175 for_statement: FOR LPAREN optexpr SEMI optexpr SEMI optexpr RPAREN $@8 statement

  176 optexpr: general_expression
  177        | /* empty */

  178 return_statement: RETURN optexpr SEMI

  179 io_statement: CIN INP in_list SEMI
  180             | COUT OUT out_list SEMI

  181 in_list: in_list INP in_item
  182        | in_item

  183 in_item: variable

  184 out_list: out_list OUT out_item
  185         | out_item

  186 out_item: general_expression

  187 compound_open: LBRACE

  188 comp_statement: compound_open decl_statements RBRACE
  189               | compound_open error RBRACE

  190 $@9: /* empty */

  191 main_function: main_header $@9 function_body

  192 main_header: INT MAIN LPAREN RPAREN


