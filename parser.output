Grammar

    0 $accept: program $end

    1 program: global_declarations main_function

    2 global_declarations: global_declarations global_declaration
    3                    | /* empty */

    4 global_declaration: typedef_declaration
    5                   | const_declaration
    6                   | enum_declaration
    7                   | class_declaration
    8                   | union_declaration
    9                   | global_var_declaration
   10                   | func_declaration
   11                   | error SEMI

   12 typedef_declaration: TYPEDEF typename listspec ID dims SEMI

   13 typename: standard_type
   14         | ID

   15 standard_type: CHAR
   16              | INT
   17              | FLOAT
   18              | STRING
   19              | VOID

   20 listspec: LIST
   21         | /* empty */

   22 dims: dims dim
   23     | /* empty */

   24 dim: LBRACK ICONST RBRACK
   25    | LBRACK RBRACK

   26 $@1: /* empty */

   27 const_declaration: CONST typename $@1 constdefs SEMI

   28 constdefs: constdefs COMMA constdef
   29          | constdef

   30 constdef: ID dims ASSIGN init_value

   31 init_value: expression
   32           | LBRACE init_values RBRACE

   33 init_values: init_values COMMA init_value
   34            | init_value

   35 expression: or_expression

   36 or_expression: or_expression OROP and_expression
   37              | and_expression

   38 and_expression: and_expression ANDOP equality_expression
   39               | equality_expression

   40 equality_expression: equality_expression EQUOP relational_expression
   41                    | relational_expression

   42 relational_expression: relational_expression RELOP additive_expression
   43                      | additive_expression

   44 additive_expression: additive_expression ADDOP multiplicative_expression
   45                    | multiplicative_expression

   46 multiplicative_expression: multiplicative_expression MULOP unary_expression
   47                          | unary_expression

   48 unary_expression: NOTOP unary_expression
   49                 | ADDOP unary_expression
   50                 | SIZEOP unary_expression
   51                 | INCDEC variable
   52                 | postfix_expression

   53 postfix_expression: variable INCDEC
   54                   | variable
   55                   | variable LPAREN expression_list RPAREN
   56                   | LENGTH LPAREN general_expression RPAREN
   57                   | constant
   58                   | LPAREN general_expression RPAREN
   59                   | LPAREN standard_type RPAREN
   60                   | listexpression

   61 variable: variable LBRACK general_expression RBRACK
   62         | variable DOT ID
   63         | LISTFUNC LPAREN general_expression RPAREN
   64         | decltype ID
   65         | THIS

   66 general_expression: general_expression COMMA assignment
   67                   | assignment

   68 assignment: variable ASSIGN assignment
   69           | expression

   70 expression_list: general_expression
   71                | /* empty */

   72 constant: CCONST
   73         | ICONST
   74         | FCONST
   75         | SCONST

   76 listexpression: LBRACK expression_list RBRACK

   77 $@2: /* empty */

   78 enum_declaration: ENUM ID $@2 enum_body SEMI

   79 enum_body: LBRACE id_list RBRACE
   80          | LBRACE error RBRACE

   81 id_list: id_list COMMA ID initializer
   82        | ID initializer

   83 initializer: ASSIGN init_value
   84            | /* empty */

   85 $@3: /* empty */

   86 class_declaration: CLASS ID $@3 class_body SEMI

   87 class_body: parent LBRACE members_methods RBRACE
   88           | parent LBRACE error RBRACE

   89 parent: COLON ID
   90       | /* empty */

   91 members_methods: members_methods access member_or_method
   92                | access member_or_method

   93 access: PRIVATE COLON
   94       | PROTECTED COLON
   95       | PUBLIC COLON
   96       | /* empty */

   97 member_or_method: member
   98                 | method

   99 member: var_declaration
  100       | anonymous_union

  101 var_declaration: typename variabledefs SEMI

  102 variabledefs: variabledefs COMMA variabledef
  103             | variabledef

  104 variabledef: listspec ID dims

  105 $@4: /* empty */

  106 anonymous_union: UNION $@4 union_body SEMI

  107 union_body: LBRACE fields RBRACE
  108           | LBRACE error RBRACE

  109 fields: fields field
  110       | field

  111 field: var_declaration

  112 method: short_func_declaration

  113 short_func_declaration: short_par_func_header SEMI
  114                       | nopar_func_header SEMI

  115 short_par_func_header: func_header_start LPAREN parameter_types RPAREN

  116 func_header_start: typename listspec ID

  117 parameter_types: parameter_types COMMA prototype_parameter
  118                | prototype_parameter

  119 prototype_parameter: typename REFER
  120                    | typename listspec dims

  121 nopar_func_header: func_header_start LPAREN RPAREN

  122 $@5: /* empty */

  123 union_declaration: UNION ID $@5 union_body SEMI

  124 global_var_declaration: typename init_variabledefs SEMI

  125 init_variabledefs: init_variabledefs COMMA init_variabledef
  126                  | init_variabledef

  127 init_variabledef: variabledef initializer

  128 func_declaration: short_func_declaration
  129                 | full_func_declaration

  130 full_func_declaration: full_par_func_header function_body

  131 $@6: /* empty */

  132 full_func_declaration: nopar_class_func_header $@6 function_body

  133 $@7: /* empty */

  134 full_func_declaration: nopar_func_header $@7 function_body

  135 full_par_func_header: class_func_header_start LPAREN parameter_list RPAREN
  136                     | func_header_start LPAREN parameter_list RPAREN

  137 class_func_header_start: typename listspec func_class ID

  138 func_class: ID METH

  139 parameter_list: parameter_list COMMA named_parameter
  140               | named_parameter

  141 named_parameter: typename REFER ID
  142                | typename listspec ID dims

  143 nopar_class_func_header: class_func_header_start LPAREN RPAREN

  144 function_body: LBRACE decl_statements RBRACE
  145              | LBRACE error RBRACE

  146 decl_statements: declarations statements
  147                | declarations
  148                | statements
  149                | /* empty */

  150 declarations: declarations local_declaration
  151             | local_declaration

  152 local_declaration: decltype typename variabledefs SEMI
  153                  | decltype typename error SEMI
  154                  | decltype typename variabledefs error

  155 decltype: STATIC
  156         | /* empty */

  157 statements: statements statement
  158           | statement

  159 statement: expression_statement
  160          | if_statement
  161          | while_statement
  162          | for_statement
  163          | return_statement
  164          | io_statement
  165          | comp_statement
  166          | CONTINUE SEMI
  167          | BREAK SEMI
  168          | SEMI
  169          | error SEMI

  170 expression_statement: general_expression SEMI

  171 if_statement: IF LPAREN general_expression RPAREN statement
  172             | IF LPAREN general_expression RPAREN statement ELSE statement

  173 $@8: /* empty */

  174 while_statement: WHILE LPAREN general_expression RPAREN $@8 statement

  175 $@9: /* empty */

  176 for_statement: FOR LPAREN optexpr SEMI optexpr SEMI optexpr RPAREN $@9 statement

  177 optexpr: general_expression
  178        | /* empty */

  179 return_statement: RETURN optexpr SEMI

  180 io_statement: CIN INP in_list SEMI
  181             | COUT OUT out_list SEMI

  182 in_list: in_list INP in_item
  183        | in_item

  184 in_item: variable

  185 out_list: out_list OUT out_item
  186         | out_item

  187 out_item: general_expression

  188 compound_open: LBRACE

  189 comp_statement: compound_open decl_statements RBRACE
  190               | compound_open error RBRACE

  191 $@10: /* empty */

  192 main_function: main_header $@10 function_body

  193 main_header: INT MAIN LPAREN RPAREN


